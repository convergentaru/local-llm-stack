[global]
    monitor              = 0
    follow               = mouse
    width                = 300
    height               = 150
    origin               = top-right
    offset               = 12x54
    scale                = 0
    notification_limit   = 5
    progress_bar         = true
    progress_bar_height  = 8
    transparency         = 15
    padding              = 12
    horizontal_padding   = 14
    frame_width          = 2
    frame_color          = "#7aa2f7"
    separator_height     = 1
    separator_color      = "#414868"
    sort                 = yes
    font                 = JetBrainsMono Nerd Font 10
    format               = "<b>%s</b>\n%b"
    alignment            = left
    word_wrap            = yes
    show_indicators      = yes
    icon_position        = left
    min_icon_size        = 28
    max_icon_size        = 48
    corner_radius        = 10
    mouse_left_click     = close_current
    mouse_right_click    = close_all

[urgency_low]
    background  = "#1a1b26"
    foreground  = "#c0caf5"
    frame_color = "#414868"
    timeout     = 4

[urgency_normal]
    background  = "#1a1b26"
    foreground  = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout     = 6

[urgency_critical]
    background  = "#1a1b26"
    foreground  = "#f7768e"
    frame_color = "#f7768e"
    timeout     = 0
