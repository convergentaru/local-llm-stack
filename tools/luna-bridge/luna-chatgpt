import os
import sys
import json
import requests
from datetime import datetime

# Configuration
LUNA_API_URL = "https://luna.example.com/api"
CHATGPT_URL = "https://chatgpt.example.com/api"

# Helper functions
def get_config():
    config_path = os.path.expanduser("~/.luna/config.json")
    if os.path.exists(config_path):
        with open(config_path, "r") as f:
            return json.load(f)
    return {}

def save_config(config):
    config_path = os.path.expanduser("~/.luna/config.json")
    with open(config_path, "w") as f:
        json.dump(config, f)

def send_request(url, data):
    try:
        response = requests.post(url, json=data, timeout=10)
        response.raise_for_status()
        return response.json()
    except requests.exceptions.RequestException as e:
        print(f"Error: {e}")
        return None

def main():
    config = get_config()
    if not config:
        print("Error: No Luna configuration found.")
        return

    # Example usage: send a message to ChatGPT
    message = "Hello, ChatGPT!"
    response = send_request(CHATGPT_URL, {
        "message": message,
        "config": config
    })

    if response:
        print("Response from ChatGPT:")
        print(response.get("response", "No response received"))
    else:
        print("Failed to send message to ChatGPT.")

if __name__ == "__main__":
    main()
