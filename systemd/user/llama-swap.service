[Unit]
Description=llama-swap local model manager
After=network.target

[Service]
Type=simple
ExecStart=%h/bin/llama-swap -config %h/local-llm-stack/llama-swap.yaml -listen 127.0.0.1:8080 -watch-config
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity
KillMode=control-group
Environment=HOME=%h
Environment=PATH=%h/llama.cpp/build-cublas/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
