# Local LLM Stack — environment template
#
# Copy this file to:
#   litellm/.env.gateway
#
# IMPORTANT:
# - Never commit real secrets.
# - Use unique random values for every installation.
# - Keep this file as a template only.

# LiteLLM authentication key.
# Used by local clients and the LiteLLM gateway.
LITELLM_MASTER_KEY=sk-change-me

# LiteLLM signing / encryption salt.
# Generate a separate random value; do not reuse LITELLM_MASTER_KEY.
LITELLM_SALT_KEY=change-me-with-a-random-secret
